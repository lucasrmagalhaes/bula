# Copie para .env (na raiz) e preencha. Os dois serviços leem este mesmo arquivo.
# Sem .env o projeto sobe em modo offline: busca e API funcionam, sem modelo de linguagem.

# --- LLM -------------------------------------------------------------------
# anthropic | openai | google | offline
LLM_PROVIDER=anthropic
# Modelo do agente. Com anthropic, o padrão é claude-opus-5-5. Com openai e google é obrigatório.
LLM_MODEL=
# Modelo das etapas de reescrita e triagem do RAG (serviço Python). Vazio usa LLM_MODEL.
# É a alavanca de custo e latência: são chamadas curtas e frequentes.
LLM_FAST_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

LLM_MAX_RETRIES=2
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=16000
# Esforço de raciocínio (Anthropic): low | medium | high | xhigh | max.
# LLM_EFFORT vale para o RAG (padrão low); AGENT_EFFORT, para o agente (vazio = padrão do modelo).
# Deixe os dois vazios em modelos que não aceitam o parâmetro.
LLM_EFFORT=low
AGENT_EFFORT=
# Reencaminha recusas para outro modelo, no servidor da Anthropic (recurso em beta).
ANTHROPIC_FALLBACKS=true
# A URL da API é sempre explícita: ANTHROPIC_BASE_URL do ambiente é ignorada de propósito.
ANTHROPIC_API_URL=https://api.anthropic.com

# Preço por milhão de tokens, para o custo aparecer em cada resposta. Vazio = não calcula.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# --- Docker Compose ----------------------------------------------------------
# Só o docker-compose.yml usa: senha do Postgres do compose. Troque antes de subir.
POSTGRES_PASSWORD=

# --- Serviço de conhecimento (Python) --------------------------------------
# Vazio sobe um Postgres embutido em ./data/pg (extra "embedded"). Em produção, aponte para
# um Postgres com a extensão pgvector: postgresql://usuario:senha@host:5432/bula
DATABASE_URL=
KNOWLEDGE_HOST=127.0.0.1
KNOWLEDGE_PORT=8100
# Se definido, /v1/* exige "Authorization: Bearer <token>". Use em qualquer rede compartilhada.
KNOWLEDGE_API_TOKEN=

EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_DIM=384
SEARCH_K=6
RAG_MAX_ATTEMPTS=2
LEXICAL_MIN_COVERAGE=0.35
OFFLINE_MAX_DISTANCE=0.6
# Aumenta o limite da API do GitHub na ingestão e na tool de releases. Opcional.
GITHUB_TOKEN=

# --- MLflow -----------------------------------------------------------------
# Vazio grava em ./data/mlflow.db. Para um servidor: http://host:5000
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=bula
# true grava um trace por execução do workflow de RAG.
MLFLOW_TRACING=false

# --- Agente (Node) ----------------------------------------------------------
KNOWLEDGE_URL=http://127.0.0.1:8100
AGENT_HOST=127.0.0.1
AGENT_PORT=8200
# Teto de chamadas ao modelo por pergunta e de perguntas por conversa.
AGENT_MAX_STEPS=6
AGENT_MAX_TURNS=20
RATE_LIMIT_PER_MINUTE=30
TOOL_TIMEOUT_MS=10000
LOG_LEVEL=info
